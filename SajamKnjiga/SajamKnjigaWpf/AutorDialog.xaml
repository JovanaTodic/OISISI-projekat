<Window x:Class="SajamKnjigaWpf.AutorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SajamKnjigaWpf"
        Title="Dodavanje autora"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,10,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ime *"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtIme" TextChanged="Polje_Changed"/>

        <TextBlock Grid.Row="1" Text="Prezime *"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtPrezime" TextChanged="Polje_Changed"/>

        <TextBlock Grid.Row="2" Text="Datum rođenja *"/>
        <DatePicker Grid.Row="2" Grid.Column="1" x:Name="dpDatumRodjenja"
                    SelectedDateChanged="Polje_Changed"/>

        <TextBlock Grid.Row="3" Text="Telefon *"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtTelefon" TextChanged="Polje_Changed"/>

        <TextBlock Grid.Row="4" Text="E-mail *"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtEmail" TextChanged="Polje_Changed"/>

        <TextBlock Grid.Row="5" Text="Broj lične karte *"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtBrojLicneKarte" TextChanged="Polje_Changed"/>

        <TextBlock Grid.Row="6" Text="Godine iskustva *"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtGodineIskustva" TextChanged="Polje_Changed"/>

        <TextBlock Grid.Row="7" Text="Ulica *"/>
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="txtUlica" TextChanged="Polje_Changed"/>

        <TextBlock Grid.Row="8" Text="Broj *"/>
        <TextBox Grid.Row="8" Grid.Column="1" x:Name="txtBroj" TextChanged="Polje_Changed"/>

        <TextBlock Grid.Row="9" Text="Grad *"/>
        <TextBox Grid.Row="9" Grid.Column="1" x:Name="txtGrad" TextChanged="Polje_Changed"/>

        <TextBlock Grid.Row="10" Text="Država *"/>
        <TextBox Grid.Row="10" Grid.Column="1" x:Name="txtDrzava" TextChanged="Polje_Changed"/>

        <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnOdustani" Content="Odustani" Width="90" Padding="4"
                    IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="btnPotvrdi" Content="Potvrdi" Width="90" Padding="4"
                    IsDefault="True" IsEnabled="False" Click="Potvrdi_Click"/>
        </StackPanel>

    </Grid>
</Window>
